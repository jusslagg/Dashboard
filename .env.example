SECRET_KEY=generar-un-secreto-largo-con-python-secrets-token-urlsafe
APP_ENV=development
APP_DEFAULT_YEAR=2026

# Linea base historica de distribucion PLP incluida con el proyecto.
PLP_BASE_YEAR=2026

# Local por defecto:
DATABASE_URL=sqlite:///facturacion.db

# Ejemplo PostgreSQL:
# DATABASE_URL=postgresql+psycopg://usuario:password@host:5432/facturacion

CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:8009,http://localhost:8009
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8009
FLASK_HOST=127.0.0.1
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
LOGIN_BLOCK_SECONDS=300
FLASK_DEBUG=0
FLASK_RELOAD=0
TEMPLATES_AUTO_RELOAD=0
SESSION_COOKIE_SECURE=0
SESSION_MINUTES=60
MAX_CONTENT_LENGTH=10485760
