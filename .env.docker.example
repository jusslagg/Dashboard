# Copy to .env.docker. This example is for a local HTTP acceptance test.
# Generate SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
APP_ENV=development
DASHBOARD_IMAGE=dashboard-facturacion:local
DASHBOARD_BIND_IP=127.0.0.1
DASHBOARD_PORT=8010
DATABASE_URL=sqlite:////opt/dashboard/instance/facturacion.db
CORS_ORIGINS=http://127.0.0.1:8010,http://localhost:8010
APP_DEFAULT_YEAR=2026
PLP_BASE_YEAR=2026
SESSION_COOKIE_SECURE=0
SESSION_MINUTES=60
MAX_CONTENT_LENGTH=10485760

# Company deployment behind HTTPS:
# APP_ENV=production (automatically enforces Secure session cookies)
# CORS_ORIGINS=https://dashboard.empresa.example
# DATABASE_URL=postgresql+psycopg://user:password@database-host:5432/facturacion
# DASHBOARD_IMAGE=registro.empresa.example/equipo/dashboard-facturacion:version
# If the proxy is in another container or access is directly through Wi-Fi:
# DASHBOARD_BIND_IP=0.0.0.0
